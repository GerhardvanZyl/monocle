        <mxCell id="e_app_core" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;exitX=0;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.8235294118;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="core">
