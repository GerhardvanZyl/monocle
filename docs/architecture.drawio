        </mxCell>
        <mxCell id="e_claude_mcp" value="spawns Monocle.Mcp.exe&lt;br&gt;and speaks MCP over stdio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeWidth=2;strokeColor=#d79b00;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=11;" edge="1" parent="1" source="claudecli" target="mcp">
