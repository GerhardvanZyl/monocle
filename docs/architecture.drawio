<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="Monocle Architecture" id="monocle-arch">
    <mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Monocle — project structure and process boundaries" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="app" value="Monocle.App&#10;Avalonia MVVM desktop UI" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1020" height="280" as="geometry" />
        </mxCell>
        <mxCell id="app_views" value="&lt;b&gt;Views / Controls&lt;/b&gt;&lt;br&gt;&lt;br&gt;thumbnail grid&lt;br&gt;filmstrip&lt;br&gt;flowchart&lt;br&gt;charts&lt;br&gt;crop · fullscreen zoom" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#f3eefc;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="320" height="190" as="geometry" />
        </mxCell>
        <mxCell id="app_vms" value="&lt;b&gt;ViewModels&lt;/b&gt;&lt;br&gt;&lt;br&gt;MainWindowViewModel&lt;br&gt;PhotoTileViewModel&lt;br&gt;PhotoRowViewModel&lt;br&gt;PipelineRowViewModel&lt;br&gt;ModelOptionViewModel" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#f3eefc;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="395" y="130" width="320" height="190" as="geometry" />
        </mxCell>
        <mxCell id="app_svc" value="&lt;b&gt;Services&lt;/b&gt;&lt;br&gt;&lt;br&gt;CullLauncher — resolves claude.exe and&lt;br&gt;the .NET host, writes the temp .mcp.json&lt;br&gt;LlamaServer · SidecarLauncher&lt;br&gt;SidecarInstaller · OnnxExporter&lt;br&gt;AppSettings · RejectMover · RatingHistory" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#f3eefc;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="130" width="310" height="190" as="geometry" />
        </mxCell>

        <mxCell id="llama" value="&lt;b&gt;llama.cpp server&lt;/b&gt; — local, Vulkan&lt;br&gt;skipped entirely unless MONOCLE_QWEN_LLAMA_URL is set;&lt;br&gt;reused if already up, else launched from MONOCLE_QWEN_LLAMA_EXE" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="66" width="480" height="100" as="geometry" />
        </mxCell>

        <mxCell id="mcp" value="Monocle.Mcp — standalone executable, own process" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1220" y="200" width="480" height="140" as="geometry" />
        </mxCell>
        <mxCell id="mcp_tools" value="&lt;b&gt;PhotoTools&lt;/b&gt; — the only tools Claude may call:&lt;br&gt;scan_folder · get_preview · get_metrics · list_burst_groups · set_rating · set_notes&lt;br&gt;&lt;i&gt;MonocleTools.All must stay in sync with this list&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#fff5eb;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1240" y="255" width="440" height="70" as="geometry" />
        </mxCell>

        <mxCell id="models" value="Monocle.Models — the scoring layer" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="1020" height="380" as="geometry" />
        </mxCell>
        <mxCell id="seam" value="&lt;b&gt;IModelRunner&lt;/b&gt; — the model seam&lt;br&gt;&lt;br&gt;IsAvailableAsync() · ScoreAsync()&lt;br&gt;ModelRegistry · ModelDescriptor&lt;br&gt;&lt;br&gt;Register a runner and it appears in&lt;br&gt;the picker with no other code change.&lt;br&gt;Any combination may be enabled." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#c5dbf7;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="270" height="160" as="geometry" />
        </mxCell>
        <mxCell id="shootsvc" value="&lt;b&gt;ShootService.AnalyzeAsync&lt;/b&gt; — the orchestrator&lt;br&gt;&lt;br&gt;metrics and EXIF from ShootCache, or decode once&lt;br&gt;builds one ScoringContext, so the shared luma,&lt;br&gt;RGB and preview are never computed twice&lt;br&gt;caches each ModelScore&lt;br&gt;&lt;br&gt;&lt;i&gt;a single runner throwing is swallowed, so one&lt;br&gt;model failing never breaks a run&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#c5dbf7;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="345" y="470" width="295" height="160" as="geometry" />
        </mxCell>
        <mxCell id="m_support" value="&lt;b&gt;Query, stats and export&lt;/b&gt;&lt;br&gt;PhotoQuery · ShootStats · ShootExporter (CSV / JSON)&lt;br&gt;DefaultModelCatalog · UnsupportedModelCatalog · PipelineStatus" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#c5dbf7;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="645" width="580" height="120" as="geometry" />
        </mxCell>
        <mxCell id="r_heur" value="&lt;b&gt;HeuristicRunner&lt;/b&gt; — fallback rating for unrated frames" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#eaf2fd;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="655" y="460" width="385" height="55" as="geometry" />
        </mxCell>
        <mxCell id="r_aes" value="&lt;b&gt;AestheticRunner&lt;/b&gt; — native, in-process" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#eaf2fd;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="655" y="525" width="385" height="55" as="geometry" />
        </mxCell>
        <mxCell id="r_claude" value="&lt;b&gt;ClaudeCullRunner / ClaudeCullService&lt;/b&gt;&lt;br&gt;ClaudeStreamParser · ClaudeEvent · CullResume" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#eaf2fd;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="655" y="590" width="385" height="55" as="geometry" />
        </mxCell>
        <mxCell id="r_sidecar" value="&lt;b&gt;SidecarRunner / SidecarClient / SidecarManager&lt;/b&gt;&lt;br&gt;generic — a new HF model needs no C# change" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#eaf2fd;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="655" y="655" width="385" height="55" as="geometry" />
        </mxCell>
        <mxCell id="r_onnx" value="&lt;b&gt;OnnxScoreRunner&lt;/b&gt; — Preprocessor · SessionFactory&lt;br&gt;OnnxModelCatalog · OnnxModelInstaller" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#eaf2fd;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="655" y="720" width="385" height="50" as="geometry" />
        </mxCell>

        <mxCell id="claudecli" value="&lt;b&gt;Claude Code CLI&lt;/b&gt; — the user's own install, no API keys read or stored&lt;br&gt;&lt;br&gt;--strict-mcp-config plus a generated .mcp.json naming only the co-located server&lt;br&gt;--allowedTools limited to the six mcp__monocle__* photo tools&lt;br&gt;Bash, Edit, Write, Read, WebFetch, WebSearch and Task all disallowed&lt;br&gt;emits stream-json, parsed by ClaudeStreamParser into ClaudeEvents" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="406" width="480" height="140" as="geometry" />
        </mxCell>
        <mxCell id="pysidecar" value="&lt;b&gt;python/server.py&lt;/b&gt; — optional; the app is fully functional without it&lt;br&gt;&lt;br&gt;stdlib only, so /health answers before the ML deps load&lt;br&gt;torch and transformers import lazily on the first /score" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="573" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="onnxrt" value="&lt;b&gt;ONNX Runtime&lt;/b&gt; — in-process&lt;br&gt;models/*.onnx, execution provider chosen per machine" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="697" width="480" height="90" as="geometry" />
        </mxCell>

        <mxCell id="pipeline" value="Monocle.Pipeline" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="pipe_graph" value="&lt;b&gt;PipelineGraph.BuildAnalysis&lt;/b&gt;&lt;br&gt;(useGpuModels, useClaude)&lt;br&gt;&lt;br&gt;one static stage list that drives&lt;br&gt;execution order &lt;i&gt;and&lt;/i&gt; is drawn as the&lt;br&gt;live flowchart" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#fdf6e3;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="900" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pipe_stage" value="PipelineStage · PipelineRun&lt;br&gt;ResourceKind: CPU / GPU / ClaudeTokens" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#fdf6e3;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="1000" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="core" value="Monocle.Core — references no other Monocle project" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="410" y="840" width="650" height="340" as="geometry" />
        </mxCell>
        <mxCell id="core_model" value="&lt;b&gt;Model&lt;/b&gt; — PhotoItem · PhotoFile · TechnicalMetrics · ModelScore · RatingSnapshot · CropRect&lt;br&gt;&lt;b&gt;Scan&lt;/b&gt; — FolderScanner (RAW + JPG pairing) · PathGuard · SupportedFormats&lt;br&gt;&lt;b&gt;Processes&lt;/b&gt; — ChildProcessJob, so spawned children die with the app" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#eaf5e9;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="910" width="610" height="70" as="geometry" />
        </mxCell>
        <mxCell id="core_img" value="&lt;b&gt;Imaging&lt;/b&gt; (SkiaSharp)&lt;br&gt;&lt;br&gt;IImageDecoder&lt;br&gt;SkiaImageDecoder&lt;br&gt;EmbeddedJpegExtractor&lt;br&gt;&lt;i&gt;RAW is judged from its&lt;br&gt;embedded JPEG, never&lt;br&gt;demosaiced&lt;/i&gt;&lt;br&gt;&lt;br&gt;ExifReader&lt;br&gt;OrientationMath&lt;br&gt;TechnicalMetricsCalculator" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#eaf5e9;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="995" width="195" height="165" as="geometry" />
        </mxCell>
        <mxCell id="core_side" value="&lt;b&gt;Sidecars&lt;/b&gt;&lt;br&gt;&lt;br&gt;IMetadataFormat&lt;br&gt;XmpSidecar&lt;br&gt;PlainTextSidecar&lt;br&gt;SidecarService&lt;br&gt;MonocleKeywords&lt;br&gt;NotesFormat&lt;br&gt;&lt;br&gt;AtomicFile · SidecarLock&lt;br&gt;SidecarStaleness" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#eaf5e9;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="635" y="995" width="195" height="165" as="geometry" />
        </mxCell>
        <mxCell id="core_cache" value="&lt;b&gt;Cache&lt;/b&gt;&lt;br&gt;&lt;br&gt;ShootCache&lt;br&gt;RatingEdit&lt;br&gt;&lt;br&gt;per-shoot SQLite plus&lt;br&gt;preview blobs, keyed and&lt;br&gt;invalidated by file&lt;br&gt;fingerprint, so re-opening&lt;br&gt;a shoot is instant" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#eaf5e9;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="995" width="200" height="165" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;br&gt;solid arrow — ProjectReference (compile-time)&lt;br&gt;dashed arrow — separate process or IPC&lt;br&gt;dotted arrow — file I/O&lt;br&gt;&lt;br&gt;Grey boxes are outside the solution.&lt;br&gt;Dependencies flow downward and to the right." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1250" width="380" height="170" as="geometry" />
        </mxCell>
        <mxCell id="disk_photos" value="&lt;b&gt;Photo folder on disk&lt;/b&gt;&lt;br&gt;&lt;br&gt;RAW + JPG pairs — a rating mirrors onto both&lt;br&gt;standard name.xmp, mirrored to readable name.txt&lt;br&gt;.xmp.bak / .txt.bak taken before the first edit&lt;br&gt;fields not being changed are preserved&lt;br&gt;&lt;b&gt;the proprietary .on1 file is never written&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="1250" width="400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="disk_cache" value="&lt;b&gt;.monocle-cache/&lt;/b&gt;&lt;br&gt;gitignored, per shoot&lt;br&gt;&lt;br&gt;SQLite + preview JPEG blobs&lt;br&gt;metrics · EXIF · model scores" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="1250" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="on1" value="&lt;b&gt;On1 Photo RAW / Lightroom&lt;/b&gt;&lt;br&gt;&lt;br&gt;Read the same standard sidecars, so the same shoot stays&lt;br&gt;usable from either tool. This is why only standard XMP is&lt;br&gt;written, and why pick / reject are also written as keywords —&lt;br&gt;On1's own flags do not travel in sidecars." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=8;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="1250" width="480" height="170" as="geometry" />
        </mxCell>

