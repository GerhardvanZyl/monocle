        <mxCell id="e_core_photos_a" value="decode" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;dashPattern=1 3;strokeWidth=2;strokeColor=#b85450;exitX=0.2153846154;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;fontSize=11;" edge="1" parent="1" source="core" target="disk_photos">
