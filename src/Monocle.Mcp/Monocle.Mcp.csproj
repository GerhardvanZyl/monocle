<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe (GUI subsystem) so Windows never allocates a console window for it: the Claude CLI
         launches this as a child and we can't control its spawn flags. MCP talks over stdio, which
         still works fully when the parent redirects the handles — the subsystem only governs the
         auto-created console window, not redirected std streams. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Monocle.Mcp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="0.9.0-preview.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Monocle.Models\Monocle.Models.csproj" />
  </ItemGroup>

</Project>
