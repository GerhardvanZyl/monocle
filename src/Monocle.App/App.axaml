<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Monocle.App.App"
             xmlns:local="using:Monocle.App"
             xmlns:conv="using:Monocle.App.Converters"
             RequestedThemeVariant="Dark">
             <!-- The whole UI chrome is the warm-graphite "Photo Critic" design (see _design_extract).
                  Tokens below mirror the design's CSS variables; controls are pinned to Dark so the
                  FluentTheme-painted bits (TextBox, CheckBox, ComboBox) match the dark chrome. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <!-- ===== Design tokens (mirror the Photo Critic CSS variables) ===== -->
        <!-- Surfaces -->
        <SolidColorBrush x:Key="Bg"          Color="#1C1B18"/>
        <SolidColorBrush x:Key="Surface1"    Color="#232220"/>
        <SolidColorBrush x:Key="Surface2"    Color="#2B2926"/>
        <SolidColorBrush x:Key="Surface3"    Color="#34322E"/>
        <SolidColorBrush x:Key="SurfaceHi"   Color="#3D3A35"/>
        <SolidColorBrush x:Key="BorderSoft"  Color="#36332E"/>
        <SolidColorBrush x:Key="BorderStrong" Color="#46423B"/>
        <!-- Text -->
        <SolidColorBrush x:Key="Text1" Color="#F1EEE8"/>
        <SolidColorBrush x:Key="Text2" Color="#AAA49A"/>
        <SolidColorBrush x:Key="Text3" Color="#7A736A"/>
        <!-- Accent + semantic -->
        <SolidColorBrush x:Key="Accent"     Color="#1EB5A6"/>
        <SolidColorBrush x:Key="AccentFg"   Color="#04211E"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#2E1EB5A6"/>
        <SolidColorBrush x:Key="AccentLine" Color="#731EB5A6"/>
        <SolidColorBrush x:Key="Pick"   Color="#46C97E"/>
        <SolidColorBrush x:Key="Reject" Color="#EF6A4C"/>
        <SolidColorBrush x:Key="Star"   Color="#F2B53F"/>
        <SolidColorBrush x:Key="LabRed"    Color="#EF6A4C"/>
        <SolidColorBrush x:Key="LabBlue"   Color="#5D97F6"/>
        <SolidColorBrush x:Key="LabPurple" Color="#B483F2"/>
        <SolidColorBrush x:Key="LabYellow" Color="#E8C34A"/>

        <!-- Type stacks: IBM Plex if the user has it, otherwise embedded Inter / system. -->
        <FontFamily x:Key="FontSans">IBM Plex Sans,Inter,Segoe UI,sans-serif</FontFamily>
        <FontFamily x:Key="FontMono">IBM Plex Mono,Cascadia Mono,Consolas,monospace</FontFamily>

        <!-- Tile dimensions, updated live from the toolbar thumbnail-size slider (#8). -->
        <x:Double x:Key="TileCardWidth">200</x:Double>
        <x:Double x:Key="TileImageHeight">144</x:Double>

        <conv:EqualityConverter x:Key="IsEqual"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- ===== Baseline text ===== -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        </Style>

        <!-- ===== Buttons ===== -->
        <!-- Default = secondary (surface chip). Add Classes="primary" / "ghost" to vary. -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <!-- Center content so labels (e.g. the Scan button, #6) never top-align. -->
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Surface3}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceHi}"/>
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <!-- Primary accent button -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentFg}"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <!-- Ghost / icon button -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Surface3}"/>
        </Style>

        <!-- Pill filter chip (rounded). Use Classes.on to mark the active filter. -->
        <Style Selector="Button.chip">
            <Setter Property="CornerRadius" Value="99"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.chip.on">
            <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentLine}"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>
        <Style Selector="Button.chip.on /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>

        <!-- ===== Inputs ===== -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource AccentLine}"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Style>
        <Style Selector="CheckBox:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>

        <!-- Per-model install status line: muted normally, reject-red with .err on failure. -->
        <Style Selector="TextBlock.installStatus">
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
        </Style>
        <Style Selector="TextBlock.installStatus.err">
            <Setter Property="Foreground" Value="{StaticResource Reject}"/>
        </Style>

        <!-- ===== Tabs ===== -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
        </Style>
        <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
        </Style>

        <!-- ===== Progress bars ===== -->
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="{StaticResource Surface3}"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <!-- ===== Expander ===== -->
        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Expander /template/ Border#ExpanderHeader">
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
        </Style>

        <!-- ===== Left-rail navigation buttons (#8) ===== -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Surface3}"/>
        </Style>
        <Style Selector="Button.nav.on">
            <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>
        <Style Selector="Button.nav.on /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>

        <!-- Action rows within the left rail's nav list (do something rather than navigate);
             the trailing "▸" glyph that marks them lives in the row markup, this class just keeps
             their label weight distinct from the ordered page rows. -->
        <Style Selector="Button.nav.action">
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- Empty-state card step rows (#8): flat, borderless, left-aligned — click targets that
             still read as plain card rows rather than chunky buttons. -->
        <Style Selector="Button.emptyStep">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style Selector="Button.emptyStep:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceHi}"/>
        </Style>
        <Style Selector="Button.emptyStep:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceHi}"/>
        </Style>
        <!-- FluentTheme's built-in :disabled state paints its own ContentPresenter background
             (ButtonBackgroundDisabled) regardless of the plain Background setter above, which would
             otherwise show as a stray grey box while Scan is unavailable — keep it flat, dim via
             Opacity only (inherited from the base Button:disabled style). -->
        <Style Selector="Button.emptyStep:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Small bordered key chip used in the keyboard-shortcuts flyout. -->
        <Style Selector="Border.keyChip">
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.keyChipText">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
        </Style>

        <!-- ===== Icon rail (design v2) =====
             38px square, icon-only; Classes.on marks the current page the way Button.nav did. -->
        <Style Selector="Button.railbtn">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.railbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
        </Style>
        <Style Selector="Button.railbtn.on">
            <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>
        <Style Selector="Button.railbtn.on /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>

        <!-- ===== Left panel: folder-tree rows, their chevron, and catalog cards ===== -->
        <Style Selector="Button.treerow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.treerow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Surface3}"/>
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
        </Style>
        <Style Selector="Button.treerow.on">
            <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>
        <Style Selector="Button.treerow.on /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>

        <Style Selector="Button.chev">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.catalogCard">
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="11,10"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.catalogCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Surface3}"/>
        </Style>
        <Style Selector="Button.catalogCard.on">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Style>

        <!-- ===== Folder-overview stat card (design v2): mono key, big mono number, quiet sub-line ===== -->
        <Style Selector="Border.statCard">
            <Setter Property="Background" Value="{StaticResource Surface1}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="17,16"/>
        </Style>
        <Style Selector="TextBlock.statKey">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
        </Style>
        <Style Selector="TextBlock.statValue">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style Selector="TextBlock.statSub">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ===== Right-panel tab buttons (#8) ===== -->
        <Style Selector="Button.rtab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style Selector="Button.rtab.on">
            <Setter Property="Background" Value="{StaticResource Surface3}"/>
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
        </Style>
        <Style Selector="Button.rtab.on /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
        </Style>

        <!-- Accent swatch (round) — Classes.on rings the active accent. -->
        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="CornerRadius" Value="99"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.swatch.on">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource Text1}"/>
        </Style>

        <!-- ===== Grid: never paint the row (ListBoxItem) selection; only the tile shows selection (#5) ===== -->
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ===== Scrollbars: thin by default, widen smoothly on hover (#4) ===== -->
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="7"/>
            <Setter Property="MinWidth" Value="7"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.12" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ScrollBar:vertical:pointerover">
            <Setter Property="Width" Value="14"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb">
            <Setter Property="MinWidth" Value="7"/>
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="MinHeight" Value="7"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Height" Duration="0:0:0.12" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ScrollBar:horizontal:pointerover">
            <Setter Property="Height" Value="14"/>
        </Style>
    </Application.Styles>
</Application>
