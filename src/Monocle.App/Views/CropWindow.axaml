<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Monocle.App.Views.CropWindow"
        Width="980" Height="740"
        Background="#141414"
        Title="Monocle — Crop">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="10">
            <TextBlock Text="Aspect:" VerticalAlignment="Center"/>
            <ComboBox Name="AspectBox" Width="110" SelectedIndex="0"/>
            <Button Content="Apply" Click="OnApply"/>
            <Button Content="Reset crop" Click="OnReset"/>
            <Button Content="Cancel" Click="OnCancel"/>
            <TextBlock Text="Drag on the image to select a crop. Enter applies, Esc cancels."
                       Foreground="#999" VerticalAlignment="Center"/>
        </StackPanel>
        <Grid Name="Stage" Margin="10">
            <Image Name="Img" Stretch="Uniform"/>
            <Canvas Name="Overlay" Background="#01000000">
                <Rectangle Name="Sel" Stroke="White" StrokeThickness="2"
                           Fill="#22FFFFFF" IsVisible="False"/>
                <Rectangle Name="V1" Fill="#66FFFFFF" Width="1" IsVisible="False"/>
                <Rectangle Name="V2" Fill="#66FFFFFF" Width="1" IsVisible="False"/>
                <Rectangle Name="H1" Fill="#66FFFFFF" Height="1" IsVisible="False"/>
                <Rectangle Name="H2" Fill="#66FFFFFF" Height="1" IsVisible="False"/>
            </Canvas>
        </Grid>
    </DockPanel>
</Window>
