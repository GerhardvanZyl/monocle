<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Monocle.App.ViewModels"
        xmlns:ctl="using:Monocle.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Monocle.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="800"
        Title="Monocle">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Padding="8" Background="#1E1E1E">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox Width="640" Watermark="Paste a folder path…" Text="{Binding FolderPath}" />
                    <CheckBox Content="Fold RAW+JPG" IsChecked="{Binding FoldPairs}" VerticalAlignment="Center"/>
                    <Button Content="Scan" Command="{Binding ScanCommand}" IsEnabled="{Binding !IsBusy}"/>
                    <Button Content="Export CSV/JSON" Command="{Binding ExportCommand}"
                            ToolTip.Tip="Export ratings, metrics, scores and notes to the shoot folder."/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Button Content="All" Command="{Binding SetFilterCommand}" CommandParameter="All"/>
                    <Button Content="★2+" Command="{Binding SetFilterCommand}" CommandParameter="Star2"/>
                    <Button Content="★3+" Command="{Binding SetFilterCommand}" CommandParameter="Star3"/>
                    <Button Content="★4" Command="{Binding SetFilterCommand}" CommandParameter="Star4"/>
                    <Button Content="Picks" Command="{Binding SetFilterCommand}" CommandParameter="Pick"/>
                    <Button Content="Rejects" Command="{Binding SetFilterCommand}" CommandParameter="Reject"/>
                    <Button Content="Unrated" Command="{Binding SetFilterCommand}" CommandParameter="Unrated"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Sort:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox ItemsSource="{Binding SortKeys}" SelectedItem="{Binding Sort}" Width="130"/>
                    <Button Content="▲ / ▼" Command="{Binding ToggleSortDirCommand}" ToolTip.Tip="Toggle ascending / descending"/>
                    <Rectangle Width="1" Fill="#444" Margin="6,2"/>
                    <TextBlock Text="Reason:" VerticalAlignment="Center"/>
                    <Button Content="Any" Command="{Binding SetReasonCommand}" CommandParameter="None"/>
                    <Button Content="Soft" Command="{Binding SetReasonCommand}" CommandParameter="Sharpness"/>
                    <Button Content="Exposure" Command="{Binding SetReasonCommand}" CommandParameter="Exposure"/>
                    <Button Content="Noise" Command="{Binding SetReasonCommand}" CommandParameter="Noise"/>
                    <Button Content="Multiple" Command="{Binding SetReasonCommand}" CommandParameter="Multiple"/>
                    <Rectangle Width="1" Fill="#444" Margin="6,2"/>
                    <TextBlock Text="By:" VerticalAlignment="Center"/>
                    <Button Content="Any" Command="{Binding SetRatedByCommand}" CommandParameter="Any"/>
                    <Button Content="Heuristic" Command="{Binding SetRatedByCommand}" CommandParameter="Heuristic"/>
                    <Button Content="Manual" Command="{Binding SetRatedByCommand}" CommandParameter="Manual"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <ProgressBar Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding ProgressFraction}"
                                 Height="14" ShowProgressText="False"/>
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding ProgressText}"
                               Foreground="#9CF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Margin="12,0,0,0" Text="{Binding StatusText}"
                               Foreground="#CCC" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Legend -->
        <Border DockPanel.Dock="Bottom" Padding="8,4" Background="#161616">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock Text="Green border = pick · Orange = reject" Foreground="#AAA"/>
                <TextBlock Text="Dot: Red sharpness · Blue exposure · Purple noise · Gold multiple" Foreground="#AAA"/>
                <TextBlock Text="Left strip = pipeline stage (grey pending → amber → blue → teal → green rated)" Foreground="#AAA"/>
                <TextBlock Text="RAW+JPG badge = folded pair (V switches the shown file)" Foreground="#AAA"/>
                <TextBlock Text="Keys: ←→↑↓ move · 1-4 rate · P/R pick/reject · F full · C crop · [ ] rotate" Foreground="#777"/>
            </StackPanel>
        </Border>

        <!-- Main area: grid + detail, with the in-app enlarge overlay layered on top -->
        <Panel>
        <Grid ColumnDefinitions="*,380">
            <!-- Center: Library grid + Pipeline flowchart -->
            <TabControl Grid.Column="0">
                <TabItem Header="Library">
                    <!-- Virtualized grid: outer ListBox virtualizes rows; each row lays tiles horizontally. -->
                    <ListBox x:Name="PhotoGrid" Padding="6"
                             ItemsSource="{Binding PhotoRows}"
                             Background="Transparent"
                             SizeChanged="OnGridSizeChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PhotoRowViewModel">
                                <ItemsControl ItemsSource="{Binding Tiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PhotoTileViewModel">
                                            <Border Background="{Binding SelectionBrush}" CornerRadius="5" Padding="2"
                                                    PointerPressed="OnTilePressed" DoubleTapped="OnTileDoubleTapped">
                                                <Border BorderBrush="{Binding StatusBorder}" BorderThickness="3"
                                                        CornerRadius="4" Padding="2" Width="186">
                                                    <DockPanel>
                                                        <!-- Pipeline-stage strip: grey pending → green rated -->
                                                        <Rectangle DockPanel.Dock="Left" Width="4" Margin="0,0,3,0"
                                                                   RadiusX="2" RadiusY="2"
                                                                   Fill="{Binding PipelineStrip}"
                                                                   ToolTip.Tip="{Binding PipelineTip}"/>
                                                    <StackPanel>
                                                        <Panel Height="140">
                                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                                            <Ellipse Width="12" Height="12" Fill="{Binding ReasonDot}"
                                                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3"/>
                                                            <Border IsVisible="{Binding IsPair}" Background="#AA000000"
                                                                    CornerRadius="3" Padding="3,1"
                                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3">
                                                                <TextBlock Text="RAW+JPG" FontSize="9" Foreground="White"/>
                                                            </Border>
                                                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding Analyzing}"
                                                                         VerticalAlignment="Bottom" Height="3"/>
                                                        </Panel>
                                                        <TextBlock Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding StarText}" Foreground="Gold" FontSize="12"/>
                                                            <TextBlock Text="{Binding TechnicalText}" Foreground="#9CF" FontSize="11"/>
                                                            <TextBlock Text="{Binding AestheticText}" Foreground="#9F9" FontSize="11"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                <TabItem Header="Pipeline">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Row="0" Margin="8,8,8,0" Spacing="4">
                            <TextBlock Text="This flowchart is the analysis pipeline every photo flows through, top to bottom. Node colour = stage status (grey pending · blue running · green done · dark skipped); the bottom legend keys the resource each stage uses (CPU / GPU / Claude tokens)."
                                       Foreground="#888" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="Overall progress" Foreground="#AAA" FontSize="11"/>
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" Height="8"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Claude cull:" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding ClaudeModels}" SelectedItem="{Binding ClaudeModel}" Width="170"/>
                                <Button Content="Cull with Claude" Command="{Binding CullWithClaudeCommand}" IsEnabled="{Binding !CullRunning}"/>
                                <TextBlock Text="(uses your Claude Code; no API keys)" Foreground="#888" FontSize="10" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <ctl:FlowchartControl Grid.Row="1" Run="{Binding Pipeline}" Margin="8"/>
                        <Border Grid.Row="2" Height="150" Background="#161616" Margin="8,0,8,8">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding CullLog}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#BBB" FontSize="11"
                                                       TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,monospace"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="Visualizations">
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" Foreground="#888" FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="Shoot-wide summaries of this scan. Left: how your ratings are distributed. Right: every photo plotted by technical quality (x) against aesthetic score (y), so the top-right corner is your strongest frames."/>
                        <ctl:ChartsControl Stats="{Binding Stats}"/>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <!-- Detail pane -->
            <Border Grid.Column="1" Background="#202020" Padding="10">
                <DockPanel>
                    <Expander DockPanel.Dock="Top" Header="Models" IsExpanded="True" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Tick models, then Scan to apply. Hover for tradeoffs."
                                       Foreground="#888" FontSize="10" Margin="0,0,0,4"/>
                            <Button Content="Start Python sidecar" Command="{Binding StartSidecarCommand}"
                                    IsEnabled="{Binding !SidecarStarting}" HorizontalAlignment="Left"
                                    Margin="0,0,0,6" FontSize="11"
                                    ToolTip.Tip="Starts the optional sidecar for the full HuggingFace zoo (Q-Align, Qwen2-VL)."/>
                            <ItemsControl ItemsSource="{Binding Models}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModelOptionViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3"
                                              ToolTip.Tip="{Binding Tradeoffs}">
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}"
                                                      IsEnabled="{Binding Available}" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Header}" FontSize="12"/>
                                                <TextBlock Text="{Binding Description}" FontSize="10"
                                                           Foreground="#999" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                                    <Button Content="{Binding InstallLabel}" FontSize="10" Padding="6,1"
                                                            IsVisible="{Binding ShowInstall}"
                                                            IsEnabled="{Binding CanInstall}"
                                                            ToolTip.Tip="{Binding InstallTip}"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).InstallModelCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <TextBlock Text="{Binding InstallProgress, StringFormat='{}{0:P0}'}"
                                                               FontSize="10" Foreground="#9CF" VerticalAlignment="Center"
                                                               IsVisible="{Binding Installing}"/>
                                                    <Button Content="model card ↗" FontSize="10" Padding="6,1"
                                                            IsVisible="{Binding HasInfoUrl}"
                                                            ToolTip.Tip="{Binding InfoUrl}"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenUrlCommand}"
                                                            CommandParameter="{Binding InfoUrl}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding ResourceText}" FontSize="10"
                                                       Foreground="#7CF" VerticalAlignment="Top" Margin="4,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                    <ScrollViewer>
                        <StackPanel Spacing="8" IsVisible="{Binding HasSelection}">
                        <Border Height="280" Background="#111">
                            <Image Source="{Binding DetailPreview}" Stretch="Uniform"
                                   DoubleTapped="OnPreviewDoubleTapped"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="Enlarge" Click="OnFullscreenClick"
                                    ToolTip.Tip="Enlarge in-app ( F ) — scroll to zoom, drag to pan, Esc to close"/>
                            <Button Content="⟲" Command="{Binding RotateLeftCommand}" ToolTip.Tip="Rotate left ( [ )"/>
                            <Button Content="⟳" Command="{Binding RotateRightCommand}" ToolTip.Tip="Rotate right ( ] )"/>
                            <Button Content="Crop" Click="OnCropClick" ToolTip.Tip="Crop ( C )"/>
                            <Button Content="Switch RAW/JPG" Command="{Binding ToggleVariantCommand}"/>
                        </StackPanel>

                        <TextBlock Text="Rating" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="1★" Command="{Binding SetStarsCommand}" CommandParameter="1"/>
                            <Button Content="2★" Command="{Binding SetStarsCommand}" CommandParameter="2"/>
                            <Button Content="3★" Command="{Binding SetStarsCommand}" CommandParameter="3"/>
                            <Button Content="4★" Command="{Binding SetStarsCommand}" CommandParameter="4"/>
                            <Button Content="Clear" Command="{Binding SetStarsCommand}" CommandParameter="0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DetailRating}" Foreground="#DDD" TextWrapping="Wrap" FontSize="11"/>

                        <TextBlock Text="{Binding DetailExif}" Foreground="#AAA" TextWrapping="Wrap" FontSize="11"/>

                        <TextBlock Text="Metrics" FontWeight="Bold"/>
                        <TextBlock Text="{Binding DetailMetrics}" FontFamily="Cascadia Mono,Consolas,monospace"
                                   FontSize="11" TextWrapping="Wrap"/>

                        <TextBlock Text="Scores (by model)" FontWeight="Bold"/>
                        <ItemsControl ItemsSource="{Binding DetailScores}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="My notes (saved to On1 description + .txt)" FontWeight="Bold"/>
                        <TextBox Text="{Binding NotesText}" AcceptsReturn="True" Height="90"
                                 TextWrapping="Wrap" Watermark="Your own thoughts on this image…"/>
                        <Button Content="Save notes" Command="{Binding SaveNotesCommand}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

            <!-- In-app enlarged, centered photo (keeps toolbar + legend visible) -->
            <Border IsVisible="{Binding IsEnlarged}" Background="#E6101010">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#202020" Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Close (Esc)" Click="OnCloseEnlargedClick"/>
                            <TextBlock Text="Scroll to zoom · drag to pan" Foreground="#999"
                                       VerticalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <ctl:ZoomImage Source="{Binding EnlargedImage}"/>
                </DockPanel>
            </Border>
        </Panel>
    </DockPanel>
</Window>
