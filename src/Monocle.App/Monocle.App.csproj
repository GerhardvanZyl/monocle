<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\robot-neon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Copy any ONNX weights dropped in the repo-level models/ folder next to the app.
       Glob matches both foo.onnx and its external-data sibling foo.onnx.data (large models
       store weights externally; ONNX Runtime needs the .data file beside the .onnx). -->
  <ItemGroup>
    <None Include="..\..\models\*.onnx*" Link="models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.17" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.17" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.17" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.17" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.17">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Monocle.Core\Monocle.Core.csproj" />
    <ProjectReference Include="..\Monocle.Models\Monocle.Models.csproj" />
    <ProjectReference Include="..\Monocle.Pipeline\Monocle.Pipeline.csproj" />
    <!-- ReferenceOutputAssembly=false: we don't link the MCP server, only ensure it's built and
         its output is available so the cull job can launch it as a separate process. -->
    <ProjectReference Include="..\Monocle.Mcp\Monocle.Mcp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Copy the Python sidecar next to the app so it can be started on demand. Copy the whole
       project (not just *.py) so pyproject.toml ships too — the in-app "Install Python deps" runs
       `pip install <python dir>` and needs it. Exclude any local virtual-env / bytecode caches so
       a developer's multi-GB .venv never gets copied into bin/. -->
  <ItemGroup>
    <None Include="..\..\python\**\*.*"
          Exclude="..\..\python\.venv\**;..\..\python\**\__pycache__\**;..\..\python\**\*.pyc"
          Link="python\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Copy the built MCP server next to the app so the cull can spawn it. -->
  <Target Name="CopyMcpServer" AfterTargets="Build">
    <ItemGroup>
      <McpFiles Include="$(MSBuildProjectDirectory)\..\Monocle.Mcp\bin\$(Configuration)\$(TargetFramework)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(McpFiles)" DestinationFiles="@(McpFiles->'$(OutDir)mcp\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
